<div class="text-center">
    <h1 class="text-warning mb-5">Register new account</h1>
    <div class="container login-container mx-auto">
        <form id="register-form" method="POST">
            <input id="first-name" class="form-control form-control-lg mb-3" type="text" placeholder="First name" name="first-name" required>
            <input id="last-name" class="form-control form-control-lg mb-3" type="text" placeholder="Last name" name="last-name" required>
            <input id="email" class="form-control form-control-lg mb-3" type="email" placeholder="E-mail" name="email" required>
            <input id="password" class="form-control form-control-lg mb-3" type="password" placeholder="Password" name="password" required>
            
            <button type="submit" class="btn btn-info w-100" style="font-size: 25px;">Register</button>
        </form>

        <div id="email-registered" class="alert alert-danger mt-4" role="alert" style="display: none; text-align: center">
            Email is already registered.
        </div>

        <a href="/login" class="accent-link mt-4 d-inline-block">Already have an account</a>
    </div>
</div>

<script src="/js/register.js"></script>